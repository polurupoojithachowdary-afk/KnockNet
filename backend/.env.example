FRONTEND_ORIGINS=https://your-project.vercel.app
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: NVIDIA NIM API key for push-to-talk voice translation.
# Get a free key from https://build.nvidia.com (sign in, any model page, "Get API Key").
# Translation works without this — it just won't be available in the room UI.
NVIDIA_API_KEY=nvapi-your-key-here
